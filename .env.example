# Version dieser .env-Struktur. Wird von myCloud beim Start mit der vom Code erwarteten
# Version verglichen (siehe app/version.js) und in der Admin-Konsole angezeigt, falls die
# eigene .env veraltet ist. Beim manuellen Übernehmen neuer Variablen aus dieser Datei
# entsprechend mit hochzählen.
ENV_VERSION=1.0.0

# App Configuration
PORT=3030
APP_URL=http://localhost:3030
SESSION_SECRET=a_long_random_and_secure_session_secret_key_12345
REGISTRATION_ENABLED=true
# Optional: Welchen Proxys vertraut die App bei X-Forwarded-For/-Proto (Client-IP für Rate-Limits)?
# Standard (leer/auskommentiert): loopback, linklocal, uniquelocal, also nur Proxys aus lokalen/privaten
# Netzen (Caddy/Nginx auf demselben Host oder im Docker-Netz). Weitere Werte: "false" (keinem
# vertrauen, z. B. bei direktem Zugriff), Zahl (Anzahl Proxy-Hops, z. B. 1) oder IP/CIDR-Liste
# (z. B. 172.18.0.0/16). "true" vertraut jedem und macht Client-IPs fälschbar - nicht empfohlen.
# Muss zusätzlich in docker-compose.yml unter app.environment durchgereicht werden.
# TRUST_PROXY=loopback, linklocal, uniquelocal

# Database Configuration (PostgreSQL)
DB_USER=mycloud
DB_PASSWORD=mycloud_secure_password
DB_NAME=mycloud

# Email Configuration (SMTP)
EMAIL_SMTP_HOST=smtp.mailtrap.io
EMAIL_SMTP_PORT=2525
EMAIL_SMTP_USER=your_smtp_username
EMAIL_SMTP_PASS=your_smtp_password
EMAIL_FROM=noreply@mycloud.local

# SSO Configuration (e.g., Authentik / OIDC)
# Die Callback-URL wird zur Laufzeit aus der aufgerufenen Domain abgeleitet (.../auth/sso/callback)
# und ist deshalb nicht per Variable konfigurierbar.
SSO_ENABLED=false
SSO_CLIENT_ID=your_authentik_client_id
SSO_CLIENT_SECRET=your_authentik_client_secret
SSO_ISSUER_URL=https://authentik.company.local/application/o/mycloud/
